{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temitope-portfolio",
  "compatibility_date": "2026-11-01",
  // No public *.workers.dev copy of the site: it would duplicate temitopeagboola.com in search.
  "workers_dev": false,
  "preview_urls": true,
  // Custom domains: Cloudflare creates the DNS records and SSL certs on deploy.
  // www is redirected to the apex with a Redirect Rule (see dashboard).
  "routes": [
    { "pattern": "temitopeagboola.com", "custom_domain": true },
    { "pattern": "www.temitopeagboola.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./apps/web/dist",
    // /notes → notes.html, /notes/writing → notes/writing.html (prerendered pages)
    "html_handling": "auto-trailing-slash",
    // every page is prerendered, so any other path is a real 404 (dist/404.html)
    "not_found_handling": "404-page"
  }
}
